{
    "name": "softcode/magento2-seo-toolkit",
    "description": "Development setup for the Softcode Magento SEO toolkit: runs the unit tests of all modules. Install the modules themselves from modules/*.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "~8.1.0||~8.2.0||~8.3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "magento/framework": "^103.0",
        "magento/module-catalog": "*",
        "magento/module-cms": "*",
        "magento/module-configurable-product": "*",
        "magento/module-page-cache": "*",
        "magento/module-review": "*",
        "magento/module-robots": "*",
        "magento/module-sitemap": "*",
        "magento/module-store": "*"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://mirror.mage-os.org/",
            "only": ["magento/*"]
        }
    ],
    "autoload-dev": {
        "psr-4": {
            "Softcode\\LumaSpeed\\": "modules/LumaSpeed/",
            "Softcode\\Canonical\\": "modules/Canonical/",
            "Softcode\\Robots\\": "modules/Robots/",
            "Softcode\\StructuredData\\": "modules/StructuredData/",
            "Softcode\\Sitemap\\": "modules/Sitemap/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "magento/composer-dependency-version-audit-plugin": false,
            "magento/magento-composer-installer": false,
            "laminas/laminas-dependency-plugin": false,
            "dealerdirect/phpcodesniffer-composer-installer": false
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
