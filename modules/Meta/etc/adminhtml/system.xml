<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="softcode" translate="label" sortOrder="400">
            <label>Softcode</label>
        </tab>
        <section id="softcode_meta" translate="label" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Meta Tags</label>
            <tab>softcode</tab>
            <resource>Magento_Config::config</resource>
            <group id="description" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Meta description fallback</label>
                <comment>Only used when a page has no description of its own and Content > Design > HTML Head > Default Description is empty. Placeholders: {{name}}, {{title}}, {{store}}.</comment>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="category_template" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Categories without a description</label>
                </field>
                <field id="home_template" translate="label" type="text" sortOrder="25" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Homepage without text</label>
                    <comment>Used when the homepage's CMS content has no real text (e.g. only widgets). {{categories}} lists the top menu categories.</comment>
                </field>
                <field id="generic_template" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Other pages</label>
                    <comment>CMS pages use their own text instead.</comment>
                </field>
            </group>
        </section>
    </system>
</config>
