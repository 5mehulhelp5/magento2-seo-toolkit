<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- next to Magento_Robots' robots.txt router (sortOrder 10), before the standard and CMS routers -->
    <type name="Magento\Framework\App\RouterList">
        <arguments>
            <argument name="routerList" xsi:type="array">
                <item name="softcode_llms" xsi:type="array">
                    <item name="class" xsi:type="string">Softcode\Robots\Controller\LlmsRouter</item>
                    <item name="disable" xsi:type="boolean">false</item>
                    <item name="sortOrder" xsi:type="string">11</item>
                </item>
            </argument>
        </arguments>
    </type>
</config>
